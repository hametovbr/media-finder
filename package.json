{
  "name": "media-finder-tooling",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "assets:build": "pnpm ui:build",
    "delivery:validate": "node scripts/validate-delivery.mjs",
    "delivery:test": "node --test scripts/validate-delivery.test.mjs",
    "docs:check": "python scripts/check_documentation_language.py",
    "ui:dev": "pnpm --filter @media-finder/builtin-ui dev",
    "ui:format": "pnpm --filter @media-finder/builtin-ui format",
    "ui:lint": "pnpm --filter @media-finder/builtin-ui lint",
    "ui:type": "pnpm --filter @media-finder/builtin-ui typecheck",
    "ui:test": "pnpm --filter @media-finder/builtin-ui test:unit",
    "ui:browser": "pnpm --filter @media-finder/builtin-ui test:browser",
    "ui:a11y": "pnpm --filter @media-finder/builtin-ui test:a11y",
    "ui:contract": "pnpm --filter @media-finder/builtin-ui contract:check",
    "ui:build": "pnpm --filter @media-finder/builtin-ui build",
    "module-conformance:test": "node --test scripts/validate-module-conformance.test.mjs",
    "module-conformance:validate": "node scripts/validate-module-conformance.mjs",
    "py:format": "uv run ruff format --check .",
    "py:lint": "uv run ruff check .",
    "py:type": "uv run mypy",
    "py:test": "uv run pytest",
    "spec:validate": "openspec validate --all --strict",
    "spec:list": "openspec list"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.9.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "axe-core": "4.11.0",
    "htmx.org": "2.0.10",
    "smol-toml": "1.3.1",
    "yaml": "2.9.0"
  }
}
