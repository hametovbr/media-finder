{
  "$defs": {
    "ArtifactDescriptor": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "magnet"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "byte_length": {
                "maximum": 8192
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "torrent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "byte_length": {
                "maximum": 20971520
              }
            }
          }
        }
      ],
      "description": "Safe digest-and-size descriptor; it never carries an artifact body.",
      "properties": {
        "byte_length": {
          "description": "UTF-8 byte length of a magnet URI or raw byte length of a torrent payload.",
          "maximum": 20971520,
          "minimum": 1,
          "title": "Byte Length",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "magnet",
            "torrent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "byte_length",
        "sha256"
      ],
      "title": "ArtifactDescriptor",
      "type": "object"
    },
    "Artwork": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url"
      ],
      "title": "Artwork",
      "type": "object"
    },
    "ConfigurationFreeCase": {
      "additionalProperties": false,
      "properties": {
        "applicable": {
          "const": false,
          "title": "Applicable",
          "type": "boolean"
        }
      },
      "required": [
        "applicable"
      ],
      "title": "ConfigurationFreeCase",
      "type": "object"
    },
    "CorrelationResult": {
      "additionalProperties": false,
      "properties": {
        "conclusive": {
          "default": true,
          "title": "Conclusive",
          "type": "boolean"
        },
        "correlation": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation",
          "type": "string"
        },
        "external_task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Task Id"
        },
        "found": {
          "title": "Found",
          "type": "boolean"
        }
      },
      "required": [
        "found",
        "correlation"
      ],
      "title": "CorrelationResult",
      "type": "object"
    },
    "DownloadDestination": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "title": "DownloadDestination",
      "type": "object"
    },
    "DownloadSuccessCase": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Artifacts",
          "type": "array"
        },
        "correlation": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Correlation",
          "type": "string"
        },
        "destination": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Destination",
          "type": "string"
        },
        "destinations": {
          "items": {
            "$ref": "#/$defs/DownloadDestination"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Destinations",
          "type": "array"
        },
        "lookup": {
          "$ref": "#/$defs/CorrelationResult"
        },
        "submission": {
          "$ref": "#/$defs/SubmissionResult"
        }
      },
      "required": [
        "destinations",
        "artifacts",
        "destination",
        "correlation",
        "submission",
        "lookup"
      ],
      "title": "DownloadSuccessCase",
      "type": "object"
    },
    "EnvironmentVariableSpec": {
      "additionalProperties": false,
      "description": "Value-free declaration of one exact process variable.",
      "properties": {
        "description_key": {
          "title": "Description Key",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "secret": {
          "title": "Secret",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "required",
        "secret",
        "description_key"
      ],
      "title": "EnvironmentVariableSpec",
      "type": "object"
    },
    "Episode": {
      "additionalProperties": false,
      "properties": {
        "air_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Air Date"
        },
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "ordering": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordering"
        },
        "plot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
