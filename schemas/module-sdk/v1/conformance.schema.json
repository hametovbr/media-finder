          "type": "object"
        },
        "runtime_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Minutes"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "number",
        "title"
