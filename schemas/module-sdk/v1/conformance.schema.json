          "minItems": 3,
          "title": "Redaction Markers",
          "type": "array"
        },
        "redaction_probes": {
          "$ref": "#/$defs/RedactionProbeSet"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "sdk_compatibility": {
          "maxLength": 100,
          "minLength": 1,
