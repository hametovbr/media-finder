    "ModuleErrorData": {
      "additionalProperties": false,
      "description": "Serializable safe failure shape for conformance fixtures.",
      "properties": {
        "category": {
          "$ref": "#/$defs/ModuleFailureCategory"
        },
        "code": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "safe_details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Safe Details",
          "type": "object"
        }
      },
      "required": [
        "category",
        "code"
      ],
      "title": "ModuleErrorData",
      "type": "object"
    },
    "ModuleFailureCategory": {
      "description": "Stable coarse categories suitable for host-side translation.",
      "enum": [
        "configuration",
        "invalid-request",
        "invalid-identity",
        "unavailable",
        "timeout",
        "limit-exceeded",
        "rejected",
        "inconclusive",
        "unsupported"
      ],
      "title": "ModuleFailureCategory",
      "type": "string"
    },
