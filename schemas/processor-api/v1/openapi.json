  "paths": {
    "/api/v1/acquisitions/{acquisition_id}/exports/naming": {
      "get": {
        "operationId": "acquisition_naming_api_v1_acquisitions__acquisition_id__exports_naming_get",
        "parameters": [
          {
            "in": "path",
            "name": "acquisition_id",
            "required": true,
            "schema": {
              "title": "Acquisition Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "entity_type",
            "required": true,
            "schema": {
              "enum": [
                "movie",
                "tvshow",
                "season",
                "episode"
              ],
              "title": "Entity Type",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "season_number",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Season Number"
            }
          },
          {
            "in": "query",
            "name": "episode_numbers",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Episode Numbers"
            }
          },
          {
            "in": "query",
            "name": "target_extension",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Target Extension"
            }
          },
          {
            "in": "query",
            "name": "profile",
            "required": false,
            "schema": {
              "default": "jellyfin-v1",
              "title": "Profile",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NamingResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessorErrorEnvelope"
                }
              }
            },
            "description": "A valid processor integration bearer token is required."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessorErrorEnvelope"
                }
              }
            },
            "description": "The requested catalog or acquisition resource does not exist."
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessorErrorEnvelope"
                }
              }
            },
            "description": "The pinned metadata source has expired under its provider policy."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessorErrorEnvelope"
                }
              }
            },
            "description": "The request selectors or parameters are invalid."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessorErrorEnvelope"
                }
              }
            },
            "description": "The request could not be completed safely."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Acquisition Naming"
      }
    },
